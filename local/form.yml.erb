---
# Site-specific override of ../form.yml.erb - OnDemand uses this file instead
# of the root form.yml.erb whenever it exists (local/ overrides take
# precedence), so this is the config actually served in production. Pinned
# to the "cbe" cluster. Keep in sync with ../form.yml.erb for changes that
# aren't cluster-specific.
cluster: "cbe"
<%-
  require "json"

  # Module availability is read from this site's periodically-refreshed
  # module snapshot rather than shelling out to `module avail` live: this
  # app's own process runs in a mount namespace where CVMFS's nested
  # software catalogs aren't visible (confirmed via /proc/<pid>/root - only
  # the top-level /cvmfs mount is there), so `module` never gets defined no
  # matter how the shell-out is invoked. This cache is a plain local file,
  # so it sidesteps that namespace issue entirely, at the cost of only
  # being as fresh as the cache's last refresh.
  modules_cache_path = "/etc/ood/modules/cbe.json"

  # load_modules_cache never raises: a failure here (missing/unreadable
  # file, malformed JSON, etc.) must not break the rest of this form - it
  # degrades to the hardcoded fallback below and reports what went wrong
  # via the *_debug variables surfaced in the help text below, since this
  # can't be observed/tested from a dev shell that may differ from
  # wherever OnDemand actually renders this file
  load_modules_cache = ->() {
    begin
      [JSON.parse(File.read(modules_cache_path)), nil]
    rescue => e
      [{}, "#{e.class}: #{e.message}"]
    end
  }

  # collect every "fullName" (e.g. "RStudio-Server/2024.12.0+467-foss-2024a-R-4.4.2")
  # filed under top-level module base-name key(s) matching name_or_prefix
  full_names_under = ->(cache, name_or_prefix, prefix:) {
    keys = prefix ? cache.keys.select { |k| k.start_with?(name_or_prefix) } : [name_or_prefix]
    keys.flat_map { |k| (cache[k] || {}).values.map { |meta| meta["fullName"] } }.compact.uniq.sort
  }

  # escape a string for safe embedding inside a double-quoted YAML scalar
  # (block form avoids gsub's own backslash-replacement reinterpretation)
  yaml_escape = ->(s) {
    s.to_s
      .gsub("\\") { "\\\\" }
      .gsub('"') { "\\\"" }
      .gsub("\r") { "" }
      .gsub("\n") { "\\n" }
  }

  modules_cache, cache_err = load_modules_cache.call

  rstudio_server_modules = cache_err ? [] : full_names_under.call(modules_cache, "RStudio-Server", prefix: false)
  rstudio_debug = cache_err || (rstudio_server_modules.empty? ? "no RStudio-Server entries in #{modules_cache_path}" : nil)
  rstudio_debug = yaml_escape.call(rstudio_debug)[0, 300] if rstudio_debug
  rstudio_server_modules = ["RStudio-Server/2024.12.0+467-foss-2024a-R-4.4.2"] if rstudio_server_modules.empty?

  r_bundle_modules = cache_err ? [] : full_names_under.call(modules_cache, "R-bundle-", prefix: true)
  bundle_debug = cache_err || (r_bundle_modules.empty? ? "no R-bundle-* entries in #{modules_cache_path}" : nil)
  bundle_debug = yaml_escape.call(bundle_debug)[0, 300] if bundle_debug

  # toolchain generation (e.g. "2024a") and R version (e.g. "4.4.2") baked into a module name
  toolchain_of = ->(name) { name[/-(?:foss|gfbf)-(\d{4}[ab])/, 1] }
  rversion_of  = ->(name) { name[/-R-([\d.]+)\z/, 1] }

  compatible = ->(rstudio_name, bundle_name) {
    tag = toolchain_of.call(rstudio_name)
    next false if tag.nil? || !bundle_name.include?("-#{tag}")
    bundle_rver = rversion_of.call(bundle_name)
    bundle_rver.nil? || bundle_rver == rversion_of.call(rstudio_name)
  }
-%>
attributes:
  partition:
    widget: "select"
    label: "Partition"
    help: "Slurm partition to submit the job to."
    options:
      - ["CPU (c)", "c"]
      - ["GPU (g)", "g"]
      - ["High memory (m)", "m"]
  gpu_type:
    widget: "select"
    label: "GPU type"
    help: "GPU to request on the GPU (g) partition (one per session). MIG slices are a fraction of a GPU and use far less of your fair-share than a full GPU. Only shown when the GPU (g) partition is selected."
    options:
      # values are Slurm GRES type names (sinfo -p g -o %G); "" requests any GPU
      - ["NVIDIA B200 MIG slice (1g, 23 GB)", "nvidia_b200_1g.23gb"]
      - ["NVIDIA B200 (full, 180 GB)", "nvidia_b200"]
      - ["NVIDIA A100 MIG slice (3g, 20 GB)", "nvidia_a100_3g.20gb"]
      - ["NVIDIA A100 (full, 40 GB)", "nvidia_a100-sxm4-40gb"]
      - ["NVIDIA Quadro RTX 6000 (24 GB)", "quadro_rtx_6000"]
      - ["Any available GPU", ""]
  rstudio_module:
    widget: "select"
    label: "RStudio Server module"
    help: "RStudio Server build to launch. Each build is matched to a specific R version, which also filters which \"Additional R bundle\" options below are compatible.<%= rstudio_debug ? " [module discovery: #{rstudio_debug}]" : '' %>"
    options:
<%- # values are the module names themselves (not list indices), so a
    # submitted/cached choice stays valid when the module cache is refreshed
    # and its ordering shifts; script.sh.erb checks it against the cache -%>
<%- rstudio_server_modules.each do |rm| -%>
      - ["<%= yaml_escape.call(rm) %>", "<%= yaml_escape.call(rm) %>"]
<%- end -%>
  r_bundle_module:
    widget: "select"
    label: "Additional R bundle"
    help: "Optional R-bundle-* module (e.g. CRAN/Bioconductor) to load alongside the selected RStudio Server module. Options are filtered by form.js to match its R/toolchain version. Choose None to skip.<%= bundle_debug ? " [module discovery: #{bundle_debug}]" : '' %>"
    options:
      - ["None", ""]
<%- # data-compat-rstudio lists the compatible rstudio_module values (module
    # names, comma-separated - names never contain commas) for form.js to
    # filter on (OnDemand's own data-option-for-* directives were tried here
    # first but did not reliably apply, so this is a self-contained replacement) -%>
<%- r_bundle_modules.each do |bm| -%>
<%- compat_names = rstudio_server_modules.select { |rm| compatible.call(rm, bm) } -%>
      - - "<%= yaml_escape.call(bm) %>"
        - "<%= yaml_escape.call(bm) %>"
        - data-compat-rstudio: "<%= yaml_escape.call(compat_names.join(',')) %>"
<%- end -%>
  extra_modules_script: ""
  cores:
    widget: "select"
    label: "CPU cores"
    help: "Number of CPU cores to request (--cpus-per-task)."
    options:
      - ["1", "1"]
      - ["2", "2"]
      - ["4", "4"]
      - ["8", "8"]
      - ["16", "16"]
      - ["32", "32"]
  ram:
    widget: "select"
    label: "Memory (GB)"
    help: "Amount of memory to request, in GB. Sizes above 128 GB are only offered on the High memory (m) partition."
    options:
      - ["4 GB", "4"]
      - ["8 GB", "8"]
      - ["16 GB", "16"]
      - ["32 GB", "32"]
      - ["64 GB", "64"]
      - ["128 GB", "128"]
<%- # sizes only the high-memory (m) nodes can satisfy; form.js hides them
    # unless the m partition is selected -%>
      - ["256 GB", "256", data-only-partition: "m"]
      - ["512 GB", "512", data-only-partition: "m"]
      - ["1024 GB", "1024", data-only-partition: "m"]
  bc_num_hours:
    widget: "select"
    label: "Wall time (hours)"
    help: "Maximum session duration, in hours."
    value: "1"
    options:
      - ["1", "1"]
      - ["2", "2"]
      - ["4", "4"]
      - ["8", "8"]
      - ["12", "12"]
      - ["24", "24"]
      - ["48", "48"]
form:
  - rstudio_module
  - r_bundle_module
  - partition
  - gpu_type
  - extra_modules_script
  - cores
  - ram
  - bc_num_hours
