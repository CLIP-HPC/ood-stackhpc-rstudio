---
cluster: ""
# Limits follow the interactive QOS (48 CPUs, 1000 GB, 12 hours per user) and the
# submit rules on CBE.next: sessions on m need at least 128 GB, sessions on g need a GPU.
attributes:
  rstudio_module:
    value: "RStudio-Server/2024.12.0+467-foss-2024a-R-4.4.2"
  auto_queues:
    widget: "select"
    label: "Partition"
    help: |
      Slurm partition to submit the job to. Sessions on GPU (g) choose a GPU
      resource below. Sessions on high memory (m) need at least 128 GB memory.
    options:
      - ["CPU (c)", "c", data-min-ram: 1, data-set-ram: 32, data-hide-gres: true, data-hide-gres-count: true]
      - ["GPU (g)", "g", data-min-ram: 1, data-set-ram: 32]
      - ["High memory (m)", "m", data-min-ram: 128, data-set-ram: 128, data-hide-gres: true, data-hide-gres-count: true]
  extra_modules_script: ""
  gres:
    widget: "select"
    label: "Resources"
    help: "Select GPU or other Slurm GRES resources (partition g only)"
    options:
      - ["NVIDIA B200 MIG slice (23 GB)", "gpu:nvidia_b200_1g.23gb"]
      - ["NVIDIA B200 GPU (full)", "gpu:nvidia_b200"]
  gres_count:
    widget: "number_field"
    label: "Resource count"
    help: "Count of GPU or other Slurm GRES resources"
    value: 1
    min: 1
    step: 1
  cores:
    widget: "number_field"
    label: "CPU cores"
    value: 2
    min: 1
    max: 48
    step: 1
  ram:
    widget: "number_field"
    label: "Memory (GB)"
    value: 32
    min: 1
    max: 1000
    step: 1
  bc_num_hours:
    widget: "number_field"
    label: "Hours"
    value: 8
    min: 1
    max: 12
    step: 1
  bc_email_on_started: ""
form:
  - rstudio_module
  - auto_queues
  - extra_modules_script
  - gres
  - gres_count
  - cores
  - ram
  - bc_num_hours
  - bc_email_on_started
