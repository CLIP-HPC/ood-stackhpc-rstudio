---
batch_connect:
  template: "basic"
  conn_params:
    - csrf_token
# See the Slurm section at https://osc.github.io/ood-documentation/master/enable-desktops/custom-job-submission.html
script:
  job_name: "ood-rstudio"
  native:
    - "--partition"
    - "<%= auto_queues %>"
    - "--ntasks"
    - "1"
    - "--mem"
    - "<%= ram.blank? ? 4 : ram.to_i %>G"
    - "--cpus-per-task"
    - "<%= cores.blank? ? 1 : cores.to_i %>"<% if auto_queues == "g" %>
    - "--gres"
    - "<%= gres %>:<%= gres_count.blank? ? 1 : gres_count.to_i %>"<% end %>
