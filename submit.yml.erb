---
batch_connect:
  template: "basic"
  conn_params:
    - csrf_token
# See the Slurm section at https://osc.github.io/ood-documentation/master/enable-desktops/custom-job-submission.html
<%-
  # gpu_type comes from the form (a Slurm GRES type name, or "" for any GPU);
  # only accept plain GRES-name characters so a tampered value can't smuggle
  # extra syntax into the --gpus-per-task argument
  gpu_spec = (gpu_type.to_s =~ /\A[A-Za-z0-9_.\-]+\z/) ? "#{gpu_type}:1" : "1"

  # form.js only offers memory sizes valid for the chosen partition; enforce
  # the same CBE.next rules here for stale/cached or hand-edited values:
  # sessions on m need at least 200 GB (the submit filter requires 204800 MB),
  # the interactive QOS allows 1000 GB
  mem_gb = ram.blank? ? 4 : ram.to_i
  mem_gb = [mem_gb, 200].max if partition == "m"
  mem_gb = [[mem_gb, 1].max, 1000].min

  # Slurm holds a session longer than the interactive QOS allows with an unhelpful
  # pending reason, so check the same limit here; the dashboard shows the error text
  load File.join(File.dirname(__FILE__), "qos_limits.rb")
  max_hours = RStudioQos.limits[:hours]
  hours = bc_num_hours.blank? ? 1 : bc_num_hours.to_i
  if hours > max_hours
    raise ArgumentError, "OnDemand sessions can run for at most #{max_hours} hours; you asked for " \
                         "#{hours}. For longer work, submit a batch job with sbatch from a login node."
  end
-%>
script:
  job_name: "ood-rstudio"
  native:
    - "--partition"
    - "<%= partition %>"
    - "--ntasks"
    - "1"
    - "--mem"
    - "<%= mem_gb %>G"
    - "--cpus-per-task"
    - "<%= cores.blank? ? 1 : cores.to_i %>"<% if partition == "g" %>
    - "--gpus-per-task"
    - "<%= gpu_spec %>"<% end %>
